{
  "layer": "top",
  "position": "top",
  "margin-bottom": -10,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "mpris"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "custom/power-profile",
    "backlight",
    "pulseaudio",
    "network",
    "bluetooth",
    "tray",
    "custom/battery"
  ],
  "custom/power-profile": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/power-profile.sh",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/power-profile.sh --toggle",
    "interval": 30,
    "tooltip": true
  },
  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "󰊠",
      "urgent": "󰀊",
      "default": "󰝥"
    },
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },
  "bluetooth": {
    "format": "󰂲",
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱 <span size='small'>{device_battery_percentage}%</span>",
    "format-connected-battery": "󰂱 <span size='small'>{device_battery_percentage}%</span>",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "~/.config/waybar/scripts/toggle-popup.sh popup_tui_blue kitty --class popup_tui_blue -o window_padding_width=5 -o confirm_os_window_close=0 -e bluetuith",
    "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
  },
  "mpris": {
    "format": "󰝚 {artist} - {title}",
    "format-paused": "󰏤 {artist} - {title}",
    "max-length": 40,
    "interval": 1
  },
  "clock": {
    "tooltip": true,
    "tooltip-format": "{:%A, %d %B %Y}",
    "format": "{:%H:%M}",
    "interval": 60,
    "on-click": "kitty -e cal"
  },
  "network": {
    "format-wifi": "󰤢",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤠",
    "interval": 1,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "~/.config/waybar/scripts/toggle-popup.sh popup_tui_net kitty --class popup_tui_net -o confirm_os_window_close=0 -e impala",
    "on-click-right": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on"
  },
  "cpu": {
    "interval": 1,
    "format": "󰻠 <tt>{usage:>3}%</tt>",
    "on-click": "~/.config/waybar/scripts/toggle-popup.sh popup_tui_cpu kitty --class popup_tui_cpu -o window_padding_width=5 -o confirm_os_window_close=0 -e btop -c ~/.config/btop/cpu.conf"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 <tt>{percentage:>3}%</tt>",
    "tooltip": true,
    "tooltip-format": "Used: {used:0.1f}G / Total: {total:0.1f}G",
    "on-click": "~/.config/waybar/scripts/toggle-popup.sh popup_tui_mem kitty --class popup_tui_mem -o window_padding_width=5 -o confirm_os_window_close=0 -e btop -c ~/.config/btop/mem.conf"
  },
  "backlight": {
    "format": "󰖨 <tt>{percent:>3}%</tt>",
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "interval": 2
  },
  "pulseaudio": {
    "format": "{icon} <tt>{volume:>3}%</tt>",
    "format-muted": "󰖁",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "~/.config/waybar/scripts/toggle-popup.sh popup_tui_audio kitty --class popup_tui_audio -o window_padding_width=5 -o confirm_os_window_close=0 -e wiremix",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
    "interval": 2
  },
  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "return-type": "json",
    "interval": 60,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/battery-charge-toggle.sh",
    "format": "{}"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
