# Global Config
sort=-time
layer=overlay
anchor=top-right
background-color=#1e1b1ee6
text-color=#e8e6ec
width=350
height=110
margin=20
padding=15
border-size=1
border-color=#c894144d
border-radius=10
icons=1
max-icon-size=48
default-timeout=8
ignore-timeout=1
font=SF Pro Text 10
on-button-left=invoke-default-action

# Progress Bar
progress-color=over #c89414

# Urgency: Low
[urgency=low]
border-color=#7a9aaa
default-timeout=2000

# Urgency: Normal
[urgency=normal]
border-color=#cc1a20
default-timeout=5000

# Urgency: Critical
[urgency=critical]
border-color=#c89414
text-color=#c89414
default-timeout=0

[app-name=power-profile]
group-by=app-name
format=<b>%s</b>\n%b
